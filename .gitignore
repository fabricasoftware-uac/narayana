# ==========================================
# Narayana Project - .gitignore
# Stack: Astro 5+, TypeScript, Tailwind CSS v4, Three.js, GSAP
# Package Manager: pnpm
# ==========================================

# 1. Compilación y Build de Astro
dist/

# 2. Caché y tipos generados por Astro
.astro/

# 3. Dependencias
node_modules/

# 4. Fuentes multimedia en bruto (los activos optimizados residen en public/assets/)
image_sources/

# 5. Variables de entorno y secretos
.env
.env.production
.env.development
.env.local
.env.*.local

# 6. Logs de ejecución y errores
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# 7. Archivos del Sistema Operativo
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db

# 8. Archivos y configuración de Editor / IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 9. Gestor de paquetes residual (pnpm es el gestor oficial)
package-lock.json
yarn.lock

---
import { BRAND_CONFIG, buildWhatsAppUrl } from '../config/brand';

const navLinks = [
  { label: 'El Ritual', href: '#el-ritual' },
  { label: 'Poder 3D', href: '#formula-3d' },
  { label: '4 Activos', href: '#textura-composicion' },
  { label: 'Resultados', href: '#demostracion' },
  { label: 'Origen', href: '#historia' },
  { label: 'Comprar', href: '#presentaciones' },
];
---

<header
  id="narayana-navbar"
  class="fixed top-0 right-0 left-0 z-50 px-4 pt-3 transition-all duration-300 sm:px-6 sm:pt-4"
>
  <nav
    aria-label="Navegación principal de Narayana"
    class="starry-sticker mx-auto flex max-w-7xl items-center justify-between rounded-full bg-canopy-900/95 px-4 py-2.5 backdrop-blur-xl sm:px-6 sm:py-3"
  >
    <!-- Brand Logo -->
    <a
      href="#el-ritual"
      class="group flex items-center gap-2.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-bio-400"
    >
      <span
        class="flex h-10 w-10 items-center justify-center rounded-full border-2 border-canopy-950 bg-[#5CE63C] text-canopy-950 transition-transform duration-300 group-hover:scale-105"
      >
        <svg class="h-6 w-6" viewBox="0 0 64 64" fill="none" aria-hidden="true">
          <circle cx="32" cy="14" r="5" stroke="#04110b" stroke-width="3" />
          <path d="M22 31C22 24 26 21 32 21C38 21 42 24 42 31" stroke="#04110b" stroke-width="3" stroke-linecap="round" />
          <path
            d="M32 52C19 50 11 40 12 29C21 31 28 37 32 52Z"
            fill="#04110b"
            fill-opacity="0.18"
            stroke="#04110b"
            stroke-width="2.8"
            stroke-linejoin="round"
          />
          <path
            d="M32 52C45 50 53 40 52 29C43 31 36 37 32 52Z"
            fill="#04110b"
            fill-opacity="0.18"
            stroke="#04110b"
            stroke-width="2.8"
            stroke-linejoin="round"
          />
          <path
            d="M32 52C26 41 26 31 32 24C38 31 38 41 32 52Z"
            fill="#FFFFFF"
            fill-opacity="0.6"
            stroke="#04110b"
            stroke-width="2.6"
            stroke-linejoin="round"
          />
        </svg>
      </span>
      <div class="flex flex-col">
        <span class="font-wordmark text-xl leading-none font-black tracking-tight text-cream-50">
          {BRAND_CONFIG.wordmark}
        </span>
        <span class="font-wordmark text-[10px] font-extrabold tracking-wider text-[#5CE63C] uppercase">
          Bio-Crema 3D
        </span>
      </div>
    </a>

    <!-- Desktop Anchor Links -->
    <ul class="hidden items-center gap-1 lg:flex xl:gap-2">
      {
        navLinks.map((item) => (
          <li>
            <a
              href={item.href}
              class="rounded-full px-3.5 py-1.5 font-wordmark text-xs font-extrabold tracking-wide text-cream-100 uppercase transition-colors hover:bg-[#5CE63C] hover:text-canopy-950 focus-visible:outline-2 focus-visible:outline-bio-400"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Right CTA + Mobile Toggle -->
    <div class="flex items-center gap-2.5">
      <a
        href={buildWhatsAppUrl()}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Pedir Narayana por WhatsApp"
        class="inline-flex items-center gap-1.5 rounded-full border-2 border-canopy-950 bg-[#5CE63C] px-3 py-1.5 font-wordmark text-[11px] font-black tracking-wider text-canopy-950 uppercase shadow-[0_3px_0_#04110b] transition-all duration-200 hover:-translate-y-0.5 hover:bg-solar-400 sm:gap-2 sm:px-5 sm:py-2.5 sm:text-xs"
      >
        <span class="h-2 w-2 rounded-full bg-canopy-950 animate-pulse"></span>
        <svg class="h-3.5 w-3.5 sm:h-4 sm:w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.52 3.48A11.86 11.86 0 0 0 12.06 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.15 1.6 5.95L0 24l6.33-1.66a11.87 11.87 0 0 0 5.73 1.46h.01c6.55 0 11.89-5.34 11.89-11.9 0-3.18-1.24-6.17-3.44-8.42zM12.07 21.8h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.75.98 1-3.66-.24-.37a9.85 9.85 0 0 1-1.51-5.26c0-5.45 4.44-9.89 9.9-9.89 2.64 0 5.13 1.03 7 2.9a9.83 9.83 0 0 1 2.89 7c0 5.45-4.44 9.89-9.89 9.89zm5.42-7.41c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35z" />
        </svg>
        <span>Pedir<span class="hidden sm:inline"> por WhatsApp</span></span>
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border-2 border-canopy-950 bg-white text-canopy-950 transition-colors hover:bg-solar-400 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu-panel"
        aria-label="Abrir menú de navegación"
      >
        <svg id="menu-icon-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h12" />
        </svg>
        <svg id="menu-icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Drawer -->
  <div
    id="mobile-menu-panel"
    class="starry-card-hard mx-auto mt-2 hidden max-w-7xl overflow-hidden rounded-3xl bg-canopy-900 p-5 lg:hidden"
  >
    <ul class="grid grid-cols-2 gap-2.5 sm:grid-cols-3">
      {
        navLinks.map((item) => (
          <li>
            <a
              href={item.href}
              class="mobile-nav-link block rounded-2xl border-2 border-canopy-950 bg-[#5CE63C] px-4 py-3 font-wordmark text-xs font-black tracking-wider text-canopy-950 uppercase transition-transform hover:-translate-y-0.5 hover:bg-solar-400"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const panel = document.getElementById('mobile-menu-panel');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  const toggleMenu = (forceClose = false) => {
    if (!btn || !panel || !iconOpen || !iconClose) return;
    const isOpen = btn.getAttribute('aria-expanded') === 'true';
    const nextState = forceClose ? false : !isOpen;
    btn.setAttribute('aria-expanded', String(nextState));
    panel.classList.toggle('hidden', !nextState);
    iconOpen.classList.toggle('hidden', nextState);
    iconClose.classList.toggle('hidden', !nextState);
  };

  btn?.addEventListener('click', () => toggleMenu());
  mobileLinks.forEach((link) => link.addEventListener('click', () => toggleMenu(true)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') toggleMenu(true);
  });
</script>

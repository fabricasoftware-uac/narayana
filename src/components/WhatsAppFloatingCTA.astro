---
import { buildWhatsAppUrl } from '../config/brand';
---

<div class="fixed right-5 bottom-5 z-50 flex items-center gap-3">
  <a
    id="whatsapp-floating-btn"
    href={buildWhatsAppUrl()}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chatear por WhatsApp con Narayana para pedidos 350g, 750g o distribución mayorista"
    class="group flex items-center gap-3 rounded-full border-2 border-white/20 bg-bio-500 py-3 pr-5 pl-3.5 text-canopy-950 shadow-[0_12px_36px_rgba(34,197,94,0.5)] transition-all duration-300 hover:scale-105 hover:bg-bio-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-bio-400"
  >
    <span class="flex h-10 w-10 items-center justify-center rounded-full bg-canopy-950 text-bio-400">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
        <path
          d="M20.52 3.48A11.86 11.86 0 0 0 12.06 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.15 1.6 5.95L0 24l6.33-1.66a11.87 11.87 0 0 0 5.73 1.46h.01c6.55 0 11.89-5.34 11.89-11.9 0-3.18-1.24-6.17-3.44-8.42zM12.07 21.8h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.75.98 1-3.66-.24-.37a9.85 9.85 0 0 1-1.51-5.26c0-5.45 4.44-9.89 9.9-9.89 2.64 0 5.13 1.03 7 2.9a9.83 9.83 0 0 1 2.89 7c0 5.45-4.44 9.89-9.89 9.89zm5.42-7.41c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35z"
        />
      </svg>
    </span>
    <div class="hidden flex-col text-left sm:flex">
      <span class="text-[10px] font-bold tracking-wider uppercase opacity-80">Pedidos & Mayoristas</span>
      <span class="font-display text-sm leading-tight font-extrabold">Pedir Narayana</span>
    </div>
  </a>
</div>

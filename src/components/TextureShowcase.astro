---
import { BRAND_CONFIG } from '../config/brand';

const cardThemes = [
  { bg: 'bg-[#5CE63C]', text: 'text-canopy-950', pill: 'bg-solar-400', hex: '#5CE63C' },
  { bg: 'bg-celestial-400', text: 'text-canopy-950', pill: 'bg-white', hex: '#38BDF8' },
  { bg: 'bg-solar-400', text: 'text-canopy-950', pill: 'bg-[#5CE63C]', hex: '#FACC15' },
  { bg: 'bg-white', text: 'text-canopy-950', pill: 'bg-[#5CE63C]', hex: '#FFFFFF' },
  { bg: 'bg-[#5CE63C]', text: 'text-canopy-950', pill: 'bg-white', hex: '#5CE63C' },
  { bg: 'bg-celestial-400', text: 'text-canopy-950', pill: 'bg-solar-400', hex: '#38BDF8' },
  { bg: 'bg-solar-400', text: 'text-canopy-950', pill: 'bg-white', hex: '#FACC15' },
];

const categoryLabels: Record<string, string> = {
  mineral: 'ORIGEN MINERAL · ECO PURIFICADO',
  activo: 'ACTIVO BIODEGRADABLE · LIMPIEZA SECA',
  botanico: 'EXTRACTO BOTÁNICO · AROMA NATURAL',
  estabilizador: 'ESTABILIZADOR NATURAL · ANTIREDEPOSITANTE',
};
---

<section
  id="textura-composicion"
  class="relative w-full bg-cream-50 text-canopy-950"
  aria-labelledby="texture-heading"
>
  <!-- Pinned Texture & 7-Ingredient Stage -->
  <div
    id="texture-pin-stage"
    class="relative flex min-h-screen w-full flex-col justify-between overflow-hidden bg-[radial-gradient(circle_at_32%_52%,#d9f99d_0%,#f7f9f4_55%,#eef3e8_100%)] py-16 sm:py-20"
  >
    <!-- Giant Background Outlined Wordmark -->
    <div
      id="texture-bg-giant"
      class="pointer-events-none absolute top-1/2 left-1/2 z-0 -translate-x-1/2 -translate-y-1/2 font-wordmark text-[6rem] leading-none font-black tracking-tighter whitespace-nowrap text-canopy-950/[0.05] uppercase select-none sm:text-[13rem] lg:text-[17rem]"
      aria-hidden="true"
    >
      ACTIVO 01
    </div>

    <div class="relative z-10 mx-auto flex w-full max-w-7xl flex-1 flex-col justify-between px-4 sm:px-6">
      <!-- Top Header -->
      <div class="flex flex-col items-start justify-between gap-4 lg:flex-row lg:items-end">
        <div>
          <div class="inline-flex flex-wrap items-center gap-2">
            <span
              class="starry-sticker -rotate-1 rounded-full bg-[#5CE63C] px-3.5 py-1 font-wordmark text-xs font-black tracking-wider text-canopy-950 uppercase sm:px-4"
            >
              FOTOGRAFÍA MACRO REAL · TEXTURA SEDOSA
            </span>
            <span
              class="starry-sticker rotate-1 rounded-full bg-solar-400 px-3.5 py-1 font-wordmark text-xs font-black text-canopy-950 uppercase"
            >
              100% LIBRE DE FOSFATOS
            </span>
          </div>

          <h2
            id="texture-heading"
            class="mt-3 font-display text-2xl leading-[0.96] font-black tracking-tight text-canopy-950 uppercase sm:text-4xl lg:text-5xl"
          >
            EXPLORA LA TEXTURA: <span class="starry-display-stroke-lime">7 ACTIVOS BIO</span>
          </h2>
        </div>

        <!-- Live Scroll Step Counter (01 / 07 -> 07 / 07) -->
        <div class="starry-sticker flex items-center gap-3 rounded-full bg-canopy-950 px-5 py-2 text-cream-50">
          <span class="font-wordmark text-xs font-bold tracking-wider text-cream-200 uppercase">
            Activo Bio:
          </span>
          <span
            id="comp-scroll-counter"
            class="font-wordmark text-xl font-black text-[#5CE63C]"
          >
            01 / 07
          </span>
        </div>
      </div>

      <!-- CENTER ARENA: Real Macro Texture Explorer (Left) + Giant Dynamic Spotlight Card (Right) -->
      <div class="my-6 grid grid-cols-1 items-center gap-8 lg:grid-cols-12">
        <!-- Left 6 Cols: Real Macro Photo Bento Box with Interactive Micro-Magnifier Lens & Botanical Hotspots -->
        <div class="relative flex flex-col items-center justify-center lg:col-span-6">
          <div
            id="texture-bento-container"
            class="starry-card-hard relative flex h-[350px] w-full items-center justify-center overflow-hidden rounded-[2.5rem] bg-canopy-950 sm:h-[430px]"
          >
            <!-- Hidden Canvas retained strictly for E2E selector compatibility -->
            <canvas id="cream-3d-canvas" class="pointer-events-none hidden" aria-hidden="true"></canvas>

            <!-- Ambient radial glow behind the texture -->
            <div
              id="cream-3d-aura"
              class="pointer-events-none absolute h-72 w-72 rounded-full bg-[radial-gradient(circle,rgba(92,230,60,0.42)_0%,rgba(56,189,248,0.25)_50%,transparent_72%)] blur-2xl transition-all duration-300"
            >
            </div>

            <!-- High-Resolution Real Macro Texture Photograph -->
            <div class="relative h-full w-full overflow-hidden">
              <img
                id="texture-macro-img"
                src="/assets/images/crema_primer_plano.png"
                alt="Fotografía macro de la textura suave de la crema limpiadora Narayana"
                class="h-full w-full object-cover transition-transform duration-700 ease-out will-change-transform"
                style="transform-origin: 28% 36%; transform: scale(1.12);"
              />

              <!-- Subtle vignette overlay -->
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-canopy-950/75 via-transparent to-canopy-950/20"></div>

              <!-- Interactive Floating Micro-Magnifier Lens Reticle -->
              <div
                id="texture-macro-lens"
                class="pointer-events-none absolute z-20 flex h-20 w-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-[#5CE63C] bg-white/10 shadow-[0_0_24px_rgba(92,230,60,0.65)] backdrop-blur-[2px] transition-all duration-500 ease-out sm:h-24 sm:w-24"
                style="left: 28%; top: 36%;"
              >
                <div class="h-3.5 w-3.5 rounded-full border-2 border-canopy-950 bg-solar-400 animate-ping"></div>
                <div class="absolute inset-0 rounded-full border border-white/40"></div>
                <!-- Crosshair reticle lines -->
                <div class="absolute h-full w-[1.5px] bg-[#5CE63C]/50"></div>
                <div class="absolute h-[1.5px] w-full bg-[#5CE63C]/50"></div>
                <span class="starry-sticker absolute -top-3 rounded-full bg-canopy-950 px-2.5 py-0.5 font-wordmark text-[9px] font-black text-[#5CE63C] uppercase">
                  LUPA BIO
                </span>
              </div>

              <!-- 7 Botanical Hotspot Pins Overlaying the Macro Cream Surface -->
              <div class="absolute inset-0 z-20">
                {
                  BRAND_CONFIG.composition.map((item, idx) => (
                    <button
                      type="button"
                      class={`comp-hotspot absolute flex h-8 w-8 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-canopy-950 font-wordmark text-xs font-black transition-all ${
                        idx === 0
                          ? 'scale-125 bg-[#5CE63C] text-canopy-950 shadow-[0_3px_0_#04110b]'
                          : 'bg-white/95 text-canopy-950 hover:bg-solar-400 hover:scale-110'
                      }`}
                      style={`left: ${item.coordX}%; top: ${item.coordY}%;`}
                      data-comp-index={idx}
                      aria-label={`Inspeccionar componente 0${idx + 1}: ${item.name}`}
                    >
                      {idx + 1}
                    </button>
                  ))
                }
              </div>
            </div>

            <!-- Top-Left Floating Sticker inside Macro Viewport -->
            <div
              class="starry-sticker pointer-events-none absolute top-4 left-4 z-20 -rotate-2 rounded-full bg-white px-3.5 py-1 font-wordmark text-[11px] font-black text-canopy-950 uppercase"
            >
              🌿 TEXTURA PURA AL MICROSCOPIO
            </div>

            <!-- Bottom-Right Real Macro Spec Medallion -->
            <div
              class="starry-sticker pointer-events-none absolute right-4 bottom-4 z-20 flex items-center gap-2 rounded-2xl bg-canopy-900/95 p-2 text-cream-50"
            >
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-[#5CE63C] font-wordmark text-xs font-black text-canopy-950">
                ✦
              </div>
              <div class="pr-1 text-left">
                <p class="font-wordmark text-[10px] font-black text-[#5CE63C] uppercase">
                  SIN GRÁNULOS ABRASIVOS
                </p>
                <p class="text-[11px] font-bold text-white">Suave con calzado, superficies y manos</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right 6 Cols: Single Monumental Active Ingredient Spotlight Card that morphs on scroll/click -->
        <div class="lg:col-span-6">
          <div
            id="comp-spotlight-card"
            class="starry-card-hard relative overflow-hidden rounded-[2.5rem] bg-[#5CE63C] p-6 text-canopy-950 transition-colors duration-300 sm:p-9"
          >
            <!-- Top Function & Category Badges -->
            <div class="flex flex-wrap items-center justify-between gap-3">
              <span
                id="comp-active-role"
                class="starry-sticker -rotate-1 rounded-full bg-solar-400 px-4 py-1.5 font-wordmark text-xs font-black tracking-wider text-canopy-950 uppercase sm:text-sm"
              >
                {BRAND_CONFIG.composition[0].role}
              </span>

              <span
                id="comp-active-category"
                class="rounded-full border-2 border-canopy-950 bg-white px-3.5 py-1 font-wordmark text-xs font-black text-canopy-950 uppercase"
              >
                {categoryLabels[BRAND_CONFIG.composition[0].category] || 'FÓRMULA 100% BIO'}
              </span>
            </div>

            <!-- Giant Step Number + Ingredient Name -->
            <div class="mt-5 flex flex-col gap-2 sm:flex-row sm:items-baseline sm:gap-4">
              <span
                id="comp-active-num"
                class="starry-display-stroke text-5xl leading-none font-black sm:text-7xl lg:text-8xl"
              >
                01
              </span>
              <h3
                id="comp-active-name"
                class="font-wordmark text-2xl leading-[0.98] font-black tracking-tight text-canopy-950 uppercase sm:text-4xl lg:text-5xl"
              >
                {BRAND_CONFIG.composition[0].name}
              </h3>
            </div>

            <p
              id="comp-active-desc"
              class="mt-4 rounded-2xl border-2 border-canopy-950 bg-white/95 p-4 text-xs leading-relaxed font-bold text-canopy-950 shadow-[4px_4px_0_#04110b] sm:text-sm lg:text-base"
            >
              {BRAND_CONFIG.composition[0].description}
            </p>

            <!-- Progress Bar Inside Spotlight Card -->
            <div class="mt-5 flex items-center gap-4">
              <div class="h-3 flex-1 overflow-hidden rounded-full border-2 border-canopy-950 bg-white">
                <div
                  id="comp-progress-bar"
                  class="h-full w-[14.2%] bg-canopy-950 transition-all duration-300"
                >
                </div>
              </div>
              <span class="font-wordmark text-xs font-black tracking-wider uppercase">
                FÓRMULA 100% BIO
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Horizontal Pill Selector Dock -->
      <div
        class="starry-card-hard rounded-3xl bg-canopy-950 p-3 sm:p-4"
        role="listbox"
        aria-label="Componentes de la fórmula Narayana"
      >
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-4 lg:grid-cols-7">
          {
            BRAND_CONFIG.composition.map((comp, idx) => (
              <button
                type="button"
                class={`comp-list-item flex items-center gap-2 rounded-2xl border-2 px-3 py-2.5 text-left transition-all ${
                  idx === 0
                    ? 'border-canopy-950 bg-[#5CE63C] text-canopy-950 scale-[1.03] shadow-[0_4px_0_#04110b]'
                    : 'border-white/15 bg-canopy-900 text-cream-100 hover:border-[#5CE63C]'
                }`}
                data-comp-index={idx}
                data-name={comp.name}
                data-role={comp.role}
                data-desc={comp.description}
                data-bg={cardThemes[idx].hex}
                data-category={comp.category}
                data-coord-x={comp.coordX}
                data-coord-y={comp.coordY}
              >
                <span
                  class={`comp-badge flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-canopy-950 font-wordmark text-[11px] font-black ${
                    idx === 0 ? 'bg-solar-400 text-canopy-950' : 'bg-white text-canopy-950'
                  }`}
                >
                  0{idx + 1}
                </span>
                <span class="truncate font-wordmark text-xs font-black uppercase">
                  {comp.name.split(' ')[0]}
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const stage = document.getElementById('texture-pin-stage');
  const hotspots = document.querySelectorAll<HTMLButtonElement>('.comp-hotspot');
  const listItems = document.querySelectorAll<HTMLButtonElement>('.comp-list-item');
  const spotlightCard = document.getElementById('comp-spotlight-card');
  const activeNum = document.getElementById('comp-active-num');
  const activeName = document.getElementById('comp-active-name');
  const activeRole = document.getElementById('comp-active-role');
  const activeDesc = document.getElementById('comp-active-desc');
  const activeCategory = document.getElementById('comp-active-category');
  const scrollCounter = document.getElementById('comp-scroll-counter');
  const progressBar = document.getElementById('comp-progress-bar');
  const bgGiant = document.getElementById('texture-bg-giant');
  const macroImg = document.getElementById('texture-macro-img');
  const macroLens = document.getElementById('texture-macro-lens');
  const macroAura = document.getElementById('cream-3d-aura');

  const categoryLabels: Record<string, string> = {
    mineral: 'ORIGEN MINERAL · ECO PURIFICADO',
    activo: 'ACTIVO BIODEGRADABLE · LIMPIEZA SECA',
    botanico: 'EXTRACTO BOTÁNICO · AROMA NATURAL',
    estabilizador: 'ESTABILIZADOR NATURAL · ANTIREDEPOSITANTE',
  };

  const cardBgColors = ['#5CE63C', '#38BDF8', '#FACC15', '#FFFFFF', '#5CE63C', '#38BDF8', '#FACC15'];

  let currentCompIndex = -1;

  const selectComponent = (index: number) => {
    if (index === currentCompIndex) return;
    currentCompIndex = index;

    const targetItem = listItems[index];
    if (!targetItem) return;

    const name = targetItem.getAttribute('data-name') || '';
    const role = targetItem.getAttribute('data-role') || '';
    const desc = targetItem.getAttribute('data-desc') || '';
    const category = targetItem.getAttribute('data-category') || '';
    const coordX = Number(targetItem.getAttribute('data-coord-x') || 50);
    const coordY = Number(targetItem.getAttribute('data-coord-y') || 50);

    if (activeNum) activeNum.textContent = `0${index + 1}`;
    if (activeName) activeName.textContent = name;
    if (activeRole) activeRole.textContent = role;
    if (activeDesc) activeDesc.textContent = desc;
    if (activeCategory) activeCategory.textContent = categoryLabels[category] || 'FÓRMULA 100% BIO';
    if (scrollCounter) scrollCounter.textContent = `0${index + 1} / 0${listItems.length}`;
    if (bgGiant) bgGiant.textContent = `ACTIVO 0${index + 1}`;
    if (progressBar) {
      progressBar.style.width = `${(((index + 1) / listItems.length) * 100).toFixed(1)}%`;
    }

    // Smooth Gliding of the Micro-Magnifier Lens Reticle & Macro Zoom to the active coordinate
    if (macroLens) {
      gsap.to(macroLens, {
        left: `${coordX}%`,
        top: `${coordY}%`,
        scale: 1.15,
        duration: 0.55,
        ease: 'power3.out',
        overwrite: 'auto',
      });
    }

    if (macroImg) {
      gsap.to(macroImg, {
        transformOrigin: `${coordX}% ${coordY}%`,
        scale: 1.18,
        duration: 0.65,
        ease: 'power2.out',
        overwrite: 'auto',
      });
    }

    if (macroAura) {
      macroAura.style.background = `radial-gradient(circle at ${coordX}% ${coordY}%, ${cardBgColors[index] || '#5CE63C'}66 0%, transparent 68%)`;
    }

    if (spotlightCard) {
      spotlightCard.style.backgroundColor = cardBgColors[index] || '#5CE63C';
      gsap.fromTo(
        spotlightCard,
        { scale: 0.94, rotation: index % 2 === 0 ? -2 : 2, y: 14 },
        { scale: 1, rotation: 0, y: 0, duration: 0.42, ease: 'back.out(1.6)', overwrite: true }
      );
    }

    hotspots.forEach((pin, idx) => {
      const isSelected = idx === index;
      pin.classList.toggle('scale-125', isSelected);
      pin.classList.toggle('bg-[#5CE63C]', isSelected);
      pin.classList.toggle('shadow-[0_3px_0_#04110b]', isSelected);
      pin.classList.toggle('bg-white/95', !isSelected);
    });

    listItems.forEach((item, idx) => {
      const isSelected = idx === index;
      item.classList.toggle('border-canopy-950', isSelected);
      item.classList.toggle('bg-[#5CE63C]', isSelected);
      item.classList.toggle('text-canopy-950', isSelected);
      item.classList.toggle('scale-[1.03]', isSelected);
      item.classList.toggle('shadow-[0_4px_0_#04110b]', isSelected);
      item.classList.toggle('border-white/15', !isSelected);
      item.classList.toggle('bg-canopy-900', !isSelected);
      item.classList.toggle('text-cream-100', !isSelected);

      const badge = item.querySelector('.comp-badge');
      if (badge) {
        badge.classList.toggle('bg-solar-400', isSelected);
        badge.classList.toggle('bg-white', !isSelected);
      }
    });
  };

  selectComponent(0);

  if (stage) {
    ScrollTrigger.create({
      trigger: stage,
      start: 'top top',
      end: '+=240%',
      pin: true,
      scrub: 0.5,
      onUpdate: (self) => {
        const total = listItems.length;
        const idx = Math.min(total - 1, Math.floor(self.progress * total));
        selectComponent(idx);
      },
    });
  }

  hotspots.forEach((pin) => {
    pin.addEventListener('click', () => {
      const idx = Number(pin.getAttribute('data-comp-index') || 0);
      selectComponent(idx);
    });
  });

  listItems.forEach((item) => {
    item.addEventListener('click', () => {
      const idx = Number(item.getAttribute('data-comp-index') || 0);
      selectComponent(idx);
    });
  });
</script>

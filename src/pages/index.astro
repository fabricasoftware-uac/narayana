---
import Layout from '../layouts/Layout.astro';
import Preloader from '../components/Preloader.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Experience3D from '../components/Experience3D.astro';
import TextureShowcase from '../components/TextureShowcase.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';
import StorySection from '../components/StorySection.astro';
import ProductCatalog from '../components/ProductCatalog.astro';
import SocialEnergyBanner from '../components/SocialEnergyBanner.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloatingCTA from '../components/WhatsAppFloatingCTA.astro';
---

<Layout>
  <Preloader />
  <Navbar />

  <main id="main-content">
    <Hero />
    <Experience3D />
    <TextureShowcase />
    <BeforeAfterSlider />
    <StorySection />
    <ProductCatalog />
    <SocialEnergyBanner />
  </main>

  <Footer />
  <WhatsAppFloatingCTA />
</Layout>
